{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "js/main.js",
    "tests/run.js"
  ],
  "ignorePatterns": [
    "css/**",
    "*.bat",
    "_payload.b64",
    "_args.json",
    "api/**",
    "node_modules/**",
    "build.cjs",
    "config.js"
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-class-members": "off"
  }
}